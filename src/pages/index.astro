  <style>
    :root {
      font-family: 'Shantell Sans', cursive;
      color: #2a2218;
      background: #ddd5be;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; min-width: 0; }
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      background: repeating-linear-gradient(0deg, transparent 0 2px, #281c0a0c 2px 3px),
                  repeating-linear-gradient(90deg, transparent 0 2px, #281c0a0a 2px 3px);
      mix-blend-mode: multiply;
    }
    main { width: min(100% - 2.5rem, 680px); margin: 0 auto; padding: 48px 0 96px; }
    header, section, footer { position: relative; }
    header { padding-bottom: 48px; }
    h1 { font-size: clamp(2.6rem, 7vw, 4rem); line-height: 1; letter-spacing: -0.04em; margin: 24px 0 12px; transform: rotate(-1deg); }
    h2 { font-size: 1.35rem; font-style: italic; margin: 0 0 22px; text-decoration: underline dotted #b09060; text-underline-offset: 7px; }
    h3 { font-size: 1rem; margin: 0 0 6px; line-height: 1.35; }
    p { line-height: 1.65; margin: 0 0 12px; color: #5a4830; }
    a { color: inherit; text-decoration-color: #b09060; text-underline-offset: 3px; overflow-wrap: anywhere; }
    a:hover { color: #724038; }
    section, footer { padding: 38px 0; }
    .photos { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-start; }
    .photos img { width: 80px; height: 98px; object-fit: cover; background: #f2ede4; padding: 5px 5px 15px; box-shadow: 2px 4px 12px #0002; }
    .photos img:nth-child(odd) { transform: rotate(-3deg); }
    .photos img:nth-child(even) { transform: rotate(3deg); }
    .location { display: inline-block; padding: 6px 10px; margin: 0 0 16px; background: #f0e8d4; box-shadow: 1px 2px 7px #0002; font-size: .78rem; transform: rotate(2deg); }
    .intro { font-size: 1rem; max-width: 60ch; }
    article { background: #cec3ac; padding: 16px 20px; margin: 0 0 14px; box-shadow: 2px 3px 12px #00000016; }
    article:nth-of-type(odd) { transform: rotate(-.3deg); }
    article:nth-of-type(even) { transform: rotate(.3deg); }
    article p:last-child { margin-bottom: 0; }
    .meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .meta span { border: 1px solid #5a483066; padding: 2px 8px; font-size: .7rem; color: #5a4830; }
    .question { padding-left: 1.5em; text-indent: -1.5em; }
    .question span { color: #7a6a50; margin-right: .5em; }
    .coda { font-style: italic; }
    .plain-list { list-style: none; padding: 0; margin: 0; }
    .plain-list li { padding: 8px 0; line-height: 1.5; }
    .book-group { margin: 0 0 26px; }
    .book-group h3 { color: #5a4830; font-size: .85rem; letter-spacing: .04em; margin-bottom: 8px; }
    .book-group li { padding: 5px 0; }
    footer { padding-bottom: 0; }
    .contact-link { display: block; width: fit-content; margin: 0 0 10px; }
    .contact-link.featured { background: #e6bfad; padding: 9px 13px; box-shadow: 2px 3px 10px #0002; font-weight: 700; text-decoration: none; }
    .contact-link.coffee { background: #e6d28b; }
    .socials { display: flex; flex-wrap: wrap; gap: 16px; margin: 18px 0 24px; }
    .newsletter label { display: block; font-size: .85rem; margin-bottom: 8px; }
    .newsletter input, .newsletter button { font: inherit; padding: 8px 10px; border: 1px solid #b09060; }
    .newsletter input { width: min(100%, 280px); background: #faf7f0; }
    .newsletter button { background: #cdbf9f; cursor: pointer; }
    .newsletter small { display: block; margin-top: 6px; color: #7a6a50; }
  </style>
</head>
