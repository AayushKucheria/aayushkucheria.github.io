<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Aayush Kucheria — AI researcher and interface thinker." />
  <title>Aayush Kucheria</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Shantell+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 100%; height: 100%; overflow: hidden;
      background: #d4c4a8;
      font-family: 'Shantell Sans', cursive;
      color: #1c1a14;
    }

    #board {
      position: fixed;
      inset: 28px;
      background: #f3eadb;
      box-shadow: 0 4px 30px #00000025, 0 1px 6px #00000015;
    }

    .tape {
      position: fixed;
      background: #e8d9a8cc;
      box-shadow: 0 1px 3px #00000015;
    }
    .tape::before {
      content: '';
      position: absolute; inset: 0;
      border-top: 1px solid #c8b87855;
      border-bottom: 1px solid #c8b87855;
    }
    #tape-tl { top: 14px; left: 80px; width: 120px; height: 18px; transform: rotate(-2deg); }
    #tape-tr { top: 16px; right: 90px; width: 100px; height: 18px; transform: rotate(3deg); }
    #tape-bl { bottom: 14px; left: 100px; width: 110px; height: 18px; transform: rotate(1.5deg); }
    #tape-br { bottom: 16px; right: 80px; width: 115px; height: 18px; transform: rotate(-2.5deg); }
    #tape-l  { top: 45%; left: 14px; width: 18px; height: 100px; transform: rotate(2deg); }
    #tape-r  { top: 40%; right: 14px; width: 18px; height: 90px; transform: rotate(-1.5deg); }

    #canvas   { position: fixed; inset: 28px; pointer-events: none; z-index: 2; }
    #dot-layer { position: fixed; inset: 28px; cursor: crosshair; z-index: 3; }

    .user-dot {
      position: absolute; width: 8px; height: 8px; border-radius: 50%;
      background: #c8341a; transform: translate(-50%, -50%);
      opacity: 0.65; pointer-events: none;
    }
    .user-dot.old { background: #5a3a18; opacity: 0.2; }

    .island { position: fixed; z-index: 4; pointer-events: none; }
    .island a { pointer-events: auto; }

    .paper {
      background: #faf7f0;
      box-shadow: 2px 3px 12px #00000018;
      padding: 12px 16px 16px;
    }
    .sticky {
      background: #f5e97a;
      box-shadow: 2px 4px 14px #00000022;
      padding: 10px 14px 14px;
    }
    .index-card {
      background: #f0f6ff;
      box-shadow: 2px 3px 10px #00000015;
      padding: 10px 14px 14px;
      border-top: 3px solid #a8c0e0;
    }
    .torn {
      background: #fdfaf4;
      box-shadow: 2px 3px 10px #00000018;
      padding: 10px 14px 24px;
      clip-path: polygon(0 0, 100% 0, 100% 88%, 95% 92%, 90% 89%, 85% 93%, 78% 90%, 72% 95%, 65% 91%, 58% 96%, 50% 92%, 42% 96%, 35% 91%, 28% 95%, 20% 90%, 12% 94%, 5% 90%, 0 93%);
    }

    /* NAME */
    #name-block { top: 44px; left: 50px; transform: rotate(-2deg); }
    #hero-name { font-size: 7.5rem; font-weight: 800; line-height: 0.88; letter-spacing: -0.04em; color: #c8341a; }
    #hero-name .ln2 { display: block; color: #1c1a14; font-size: 5.8rem; }

    /* INTRO sticky — top right */
    #intro-block { top: 50px; right: 48px; width: 225px; transform: rotate(4deg); }
    .intro-txt { font-size: 0.93rem; font-weight: 400; font-style: italic; line-height: 1.8; color: #2a2210; }

    /* WORK */
    #work-block { top: 268px; left: 50px; width: 430px; transform: rotate(-2deg); }
    .sec-label { font-size: 5rem; font-weight: 800; line-height: 1; display: block; margin-bottom: 0.75rem; letter-spacing: -0.03em; }
    .w-item { margin-bottom: 0.65rem; }
    .w-title { font-size: 1.05rem; font-weight: 600; line-height: 1.2; }
    .w-title a { color: inherit; text-decoration: none; border-bottom: 1.5px solid #c8341a55; }
    .w-title a:hover { color: #c8341a; }
    .w-sub { font-size: 0.7rem; font-weight: 300; color: #7a6a50; font-style: italic; margin-top: 0.1rem; line-height: 1.5; }

    /* RESEARCH — torn paper, upper center */
    #research-block { top: 52px; left: 42%; transform: translateX(-50%) rotate(-3deg); width: 190px; }
    .res-label { font-size: 1.8rem; font-weight: 800; color: #2a5e8c; display: block; margin-bottom: 0.4rem; }
    .res-item { font-size: 0.82rem; font-weight: 400; margin-bottom: 0.28rem; }
    .res-sub { font-size: 0.6rem; color: #6a7a8a; font-style: italic; }

    /* THINKING — index card, right */
    #thinking-block { top: 400px; right: 48px; width: 185px; transform: rotate(-4deg); }
    .think-label { font-size: 2rem; font-weight: 800; display: block; margin-bottom: 0.45rem; color: #1c1a14; }
    .think-item { font-size: 0.9rem; margin-bottom: 0.22rem; }

    /* FLOAT NOTE */
    #float-note { top: 368px; left: 45%; transform: rotate(5deg); }
    .float-txt { font-size: 0.68rem; font-style: italic; color: #7a6050; font-weight: 300; line-height: 1.5; }

    /* READING */
    #reading-block { bottom: 68px; left: 55px; transform: rotate(-1.5deg); }
    .r-label { font-size: 1.6rem; font-weight: 700; color: #9a8a6c; display: block; margin-bottom: 0.6rem; }
    #book-list { position: relative; width: 340px; height: 155px; }
    .cover {
      position: absolute; width: 44px; height: 58px;
      border-radius: 1px 3px 3px 1px;
      box-shadow: 2px 3px 8px #00000030, inset -3px 0 6px #00000018;
      display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
      padding: 4px 3px 5px;
      transition: transform 0.15s, box-shadow 0.15s;
      cursor: pointer; pointer-events: auto; text-decoration: none;
    }
    .cover:hover { transform: scale(1.18) translateY(-5px) !important; box-shadow: 3px 6px 18px #00000045; z-index: 20 !important; }
    .cover::before { content: ''; position: absolute; top: 5px; left: 5px; right: 5px; height: 1px; background: rgba(255,255,255,0.2); }
    .cover::after  { content: ''; position: absolute; top: 0; right: 0; width: 3px; height: 100%; background: rgba(0,0,0,0.12); border-radius: 0 2px 2px 0; }
    .cover-title { writing-mode: unset; font-size: 0.36rem; font-weight: 600; color: rgba(255,255,255,0.9); text-align: center; line-height: 1.25; text-shadow: 0 1px 2px rgba(0,0,0,0.4); }
    .t1 { background: linear-gradient(160deg, #3a5c7a, #4e7a9e); }
    .t2 { background: linear-gradient(160deg, #3d6645, #547a5c); }
    .t3 { background: linear-gradient(160deg, #7a3528, #9e4a3a); }
    #c-dream  { left: 2px;   top: 4px;  transform: rotate(-3deg);   z-index: 3; }
    #c-phil   { left: 50px;  top: 0px;  transform: rotate(1.5deg);  z-index: 2; }
    #c-mind   { left: 96px;  top: 6px;  transform: rotate(-1deg);   z-index: 3; }
    #c-spell  { left: 155px; top: 2px;  transform: rotate(2.5deg);  z-index: 3; }
    #c-become { left: 200px; top: 8px;  transform: rotate(-2deg);   z-index: 2; }
    #c-love   { left: 246px; top: 3px;  transform: rotate(1deg);    z-index: 3; }
    #c-precip { left: 10px;  top: 86px; transform: rotate(-2deg);   z-index: 3; }
    #c-other  { left: 57px;  top: 80px; transform: rotate(2deg);    z-index: 2; }
    #c-live   { left: 110px; top: 88px; transform: rotate(-1.5deg); z-index: 3; }
    #c-align  { left: 160px; top: 82px; transform: rotate(3deg);    z-index: 2; }
    #cover-tip {
      position: fixed; background: #faf7f0; border-radius: 3px;
      padding: 5px 9px; font-size: 0.65rem; color: #4a3820;
      box-shadow: 1px 2px 6px #00000020; pointer-events: none; display: none; z-index: 30;
      max-width: 200px; line-height: 1.4;
    }

    /* LINKS */
    #links-block { bottom: 44px; right: 48px; text-align: right; transform: rotate(2.5deg); }
    .cal-lnk { font-size: 1.4rem; font-weight: 700; color: #2a5e8c; display: block; text-decoration: none; margin-bottom: 0.3rem; }
    .cal-lnk:hover { text-decoration: underline; }
    .sm-links { display: flex; gap: 1rem; justify-content: flex-end; margin-top: 0.4rem; }
    .sm-lnk { font-size: 0.78rem; font-weight: 300; color: #5a4830; font-style: italic; text-decoration: none; }
    .sm-lnk:hover { color: #c8341a; }

    #hint {
      position: fixed; bottom: 8px; left: 50%; transform: translateX(-50%);
      font-size: 0.6rem; font-style: italic; color: #8a7248; opacity: 0.6;
      pointer-events: none; z-index: 10;
    }
  </style>
</head>
<body>

