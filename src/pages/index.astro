<script>
  import rough from 'roughjs';
  import { annotate } from 'rough-notation';

  const dotLayer = document.getElementById('dot-layer');
  let stored = JSON.parse(localStorage.getItem('wb-v1') || '[]');
  const MAX = 100;
  const NS = 'http://www.w3.org/2000/svg';

  /* splashes only live on the right pane — drop legacy marks from the old full-board layout */
  const inRightPane = (x, clientX) =>
    (clientX != null ? clientX : x * window.innerWidth) >= dotLayer.getBoundingClientRect().left - 1;

  stored = stored.filter(([x]) => inRightPane(x));
  localStorage.setItem('wb-v1', JSON.stringify(stored));

  /* three paint colors — equal weight, contrast against --clr-board (#ddd5be) */
  const PAINT = ['#d4a828', '#3d6658', '#3a5570'];
  const pickPaint = () => PAINT[Math.floor(Math.random() * PAINT.length)];

  function blob(cx, cy, r) {
    const n = 9;
    const pts = Array.from({length: n}, (_, i) => {
      const a = (i / n) * Math.PI * 2 - Math.PI / 2;
      const noise = 0.45 + Math.random() * 1.05;
      return [cx + Math.cos(a) * r * noise, cy + Math.sin(a) * r * noise];
    });
    let d = `M ${pts[0][0].toFixed(1)} ${pts[0][1].toFixed(1)}`;
    for (let i = 0; i < n; i++) {
      const p0 = pts[(i - 1 + n) % n], p1 = pts[i];
      const p2 = pts[(i + 1) % n],     p3 = pts[(i + 2) % n];
      const f = 1/6;
      const cp1x = p1[0] + (p2[0] - p0[0]) * f, cp1y = p1[1] + (p2[1] - p0[1]) * f;
      const cp2x = p2[0] - (p3[0] - p1[0]) * f, cp2y = p2[1] - (p3[1] - p1[1]) * f;
      d += ` C ${cp1x.toFixed(1)} ${cp1y.toFixed(1)}, ${cp2x.toFixed(1)} ${cp2y.toFixed(1)}, ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
    }
    return d + ' Z';
  }

  function renderSplash(x, y, isOld) {
    const wrap = document.createElement('div');
    wrap.className = 'splash-wrap';
    wrap.style.left = (x * window.innerWidth) + 'px';
    wrap.style.top  = (y * window.innerHeight) + 'px';

    const sz   = isOld ? (22 + Math.random() * 12) : (32 + Math.random() * 18);
    const rot  = Math.random() * 360;
    const col  = pickPaint();
    const base = isOld ? 0.12 : (0.68 + Math.random() * 0.18);

    const svg = document.createElementNS(NS, 'svg');
    svg.setAttribute('viewBox', '0 0 100 100');
    svg.style.cssText = [
      `display:block`,
      `width:${sz}px`, `height:${sz}px`,
      `overflow:visible`,
      `transform:translate(-50%,-50%) rotate(${rot}deg) scale(${isOld ? 1 : 0})`,
      isOld ? '' : `transition:transform 0.38s cubic-bezier(0.34,1.56,0.64,1)`,
    ].join(';');

    const bR = 17 + Math.random() * 9;
    const blobPath = document.createElementNS(NS, 'path');
    blobPath.setAttribute('d', blob(50, 50, bR));
    blobPath.setAttribute('fill', col);
    blobPath.setAttribute('opacity', base.toFixed(2));
    svg.appendChild(blobPath);

    const drops = 4 + Math.floor(Math.random() * 5);
    for (let i = 0; i < drops; i++) {
      const a    = Math.random() * Math.PI * 2;
      const dist = bR * (1.3 + Math.random() * 2.0);
      const dr   = bR * (0.05 + Math.random() * 0.18);
      const ecx  = (50 + Math.cos(a) * dist).toFixed(1);
      const ecy  = (50 + Math.sin(a) * dist).toFixed(1);
      const el = document.createElementNS(NS, 'ellipse');
      el.setAttribute('cx', ecx); el.setAttribute('cy', ecy);
      el.setAttribute('rx', dr.toFixed(1));
      el.setAttribute('ry', (dr * (0.45 + Math.random() * 0.9)).toFixed(1));
      el.setAttribute('fill', Math.random() < 0.3 ? pickPaint() : col);
      el.setAttribute('opacity', (base * (0.35 + Math.random() * 0.65)).toFixed(2));
      el.setAttribute('transform', `rotate(${(Math.random()*120-60).toFixed(0)} ${ecx} ${ecy})`);
      svg.appendChild(el);
    }

    wrap.appendChild(svg);
    document.body.appendChild(wrap);

    if (!isOld) {
      requestAnimationFrame(() => requestAnimationFrame(() => {
        svg.style.transform = `translate(-50%,-50%) rotate(${rot}deg) scale(1)`;
      }));
    }
  }

  stored.forEach(([x, y]) => renderSplash(x, y, true));

  /* Paint on empty right-pane clicks. Ignore interactive pieces, content
     patches, and the static left pane so they stay clickable. */
  const PAINT_IGNORE = 'a, button, input, textarea, select, label, form, .corner-tab, .patch, .spine, .tag, .photo-ph, .home-pane';
  document.addEventListener('click', e => {
    if (e.target.closest(PAINT_IGNORE)) return;
    if (!inRightPane(null, e.clientX)) return;
    const x = e.clientX / window.innerWidth;
    const y = e.clientY / window.innerHeight;
    renderSplash(x, y, false);
    stored.push([x, y]);
    if (stored.length > MAX) stored.splice(0, stored.length - MAX);
    localStorage.setItem('wb-v1', JSON.stringify(stored));
  });

  /* tab switching — instant */
  const tabs = document.querySelectorAll('.corner-tab');
  const corners = document.querySelectorAll('.corner');
  tabs.forEach(tab => tab.addEventListener('click', () => {
    tabs.forEach(t => t.classList.remove('active'));
    corners.forEach(c => c.classList.remove('active'));
    tab.classList.add('active');
    document.getElementById('c-' + tab.dataset.corner).classList.add('active');
  }));

  function drawAll() {
    const canvas = document.getElementById('canvas');
    const pane = dotLayer.getBoundingClientRect();
    canvas.width = pane.width;
    canvas.height = pane.height;
  }

  function drawThreads() {
    const svg = document.getElementById('threads');
    const pane = dotLayer.getBoundingClientRect();
    svg.setAttribute('viewBox', `0 0 ${pane.width} ${pane.height}`);
    svg.innerHTML = '';
    const THREAD = '#9a7a45';

    function thread(x1, y1, x2, y2, cx, cy, op) {
      const p = document.createElementNS(NS, 'path');
      p.setAttribute('d', `M ${x1},${y1} Q ${cx},${cy} ${x2},${y2}`);
      p.setAttribute('stroke', THREAD);
      p.setAttribute('stroke-width', '0.7');
      p.setAttribute('fill', 'none');
      p.setAttribute('opacity', op ?? '0.25');
      p.setAttribute('stroke-linecap', 'round');
      svg.appendChild(p);
    }

    const w = pane.width, h = pane.height;
    const filaments = [
      [0.08,0.20,38,18],[0.22,0.47,112,20],[0.42,0.09,160,16],[0.60,0.33,55,19],
      [0.76,0.20,200,14],[0.92,0.47,80,18],[0.14,0.71,140,17],[0.32,0.82,20,20],
      [0.50,0.74,165,15],[0.68,0.90,95,22],[0.80,0.66,130,17],[0.96,0.80,45,19],
      [0.06,0.52,75,16],[0.28,0.30,190,21],[0.46,0.54,30,18],[0.62,0.74,155,16],
      [0.84,0.34,85,20],[0.98,0.19,175,14],[0.18,0.61,60,22],[0.54,0.22,130,17],
    ];
    filaments.forEach(([fx, fy, ang, len]) => {
      const x = fx * w, y = fy * h;
      const rad = ang * Math.PI / 180;
      const perp = (ang + 90) * Math.PI / 180;
      const bow = (Math.sin(x * 0.1 + y * 0.07) - 0.5) * 5;
      const mx = x + Math.cos(rad) * len * 0.5 + Math.cos(perp) * bow;
      const my = y + Math.sin(rad) * len * 0.5 + Math.sin(perp) * bow;
      thread(x, y, x + Math.cos(rad) * len, y + Math.sin(rad) * len, mx, my,
        String(0.15 + (Math.sin(x * 0.3 + y * 0.2) * 0.5 + 0.5) * 0.18));
    });
  }

  function runAnnotations() {
    const target = document.getElementById('book-group-1');
    if (!target) return;
    setTimeout(() => annotate(target, {
      type: 'bracket', color: '#b09060',
      roughness: 3.8, strokeWidth: 2.5, padding: [18, 6, 12, 6], brackets: ['left'], animationDuration: 700,
    }).show(), 400);
  }

  const tip = document.getElementById('cover-tip');
  document.querySelectorAll('.spine[data-tip]').forEach(c => {
    c.addEventListener('mouseenter', () => { tip.style.display = 'block'; tip.textContent = c.dataset.tip; });
    c.addEventListener('mousemove', e => { tip.style.left = (e.clientX + 12) + 'px'; tip.style.top = (e.clientY - 30) + 'px'; });
    c.addEventListener('mouseleave', () => { tip.style.display = 'none'; });
  });

  window.addEventListener('load', () => {
    drawAll();
    drawThreads();
    runAnnotations();
  });
  window.addEventListener('resize', () => {
    drawAll();
    drawThreads();
  });
</script>

</body>
</html>
