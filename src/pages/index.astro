<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Aayush Kucheria — AI researcher and interface thinker." />
  <title>Aayush Kucheria</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Shantell+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400&display=swap" rel="stylesheet" />
  <style>
    /*
      BOARD LAYOUT (approx 1440 × 900 viewport)
      ┌──────────────────────────────────────────────────────────┐
      │ [ph][ph] [  name  ]      [ph]  [proj][proj][proj] [rsrch]│
      │                                        [community]       │
      │ [W O R K  ——  hero, 580px wide]  [intro]                 │
      │                         [float]         [think-card]     │
      │ [links]                                 [bookshelf]      │
      └──────────────────────────────────────────────────────────┘
      All island positions live here. Change a number here to move a section.
    */
    :root {
      /* name cluster — top-left */
      --name-top: 44px;        --name-left: 195px;
      --photo1-top: 50px;      --photo1-left: 36px;
      --photo2-top: 44px;      --photo2-left: 98px;
      --photo3-top: 46px;      --photo3-left: 620px;
      /* projects — right of name/photos */
      --proj-top: 50px;        --proj-left: 800px;
      /* research — upper-right (torn paper, decorative) */
      --research-top: 52px;    --research-right: 175px;
      /* work — left-center hero */
      --work-top: 250px;       --work-left: 48px;   --work-w: 580px;
      /* thinking — mid-right (index card, decorative) */
      --thinking-top: 420px;   --thinking-right: 48px;
      /* intro — center board */
      --intro-top: 38%;        --intro-left: 54%;
      /* float note — center-low */
      --float-top: 59%;        --float-left: 50%;
      /* community — upper-right sticky */
      --community-top: 200px;  --community-right: 52px;
      /* reading — bottom-right */
      --reading-bottom: 52px;  --reading-right: 48px;
      /* links/contact — bottom-left */
      --links-bottom: 44px;    --links-left: 52px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 100%; height: 100%; overflow: hidden;
      background: #d4c4a8;
      font-family: 'Shantell Sans', cursive;
      color: #1c1a14;
    }

    #board {
      position: fixed;
      inset: 28px;
      background: #f3eadb;
      box-shadow: 0 4px 30px #00000025, 0 1px 6px #00000015;
    }

    .tape {
      position: fixed;
      background: #e8d9a8cc;
      box-shadow: 0 1px 3px #00000015;
    }
    .tape::before {
      content: '';
      position: absolute; inset: 0;
      border-top: 1px solid #c8b87855;
      border-bottom: 1px solid #c8b87855;
    }
    #tape-tl { top: 14px; left: 80px; width: 120px; height: 18px; transform: rotate(-2deg); }
    #tape-tr { top: 16px; right: 90px; width: 100px; height: 18px; transform: rotate(3deg); }
    #tape-bl { bottom: 14px; left: 100px; width: 110px; height: 18px; transform: rotate(1.5deg); }
    #tape-br { bottom: 16px; right: 80px; width: 115px; height: 18px; transform: rotate(-2.5deg); }
    #tape-l  { top: 45%; left: 14px; width: 18px; height: 100px; transform: rotate(2deg); }
    #tape-r  { top: 40%; right: 14px; width: 18px; height: 90px; transform: rotate(-1.5deg); }

    #canvas    { position: fixed; inset: 28px; pointer-events: none; z-index: 2; }
    #dot-layer { position: fixed; inset: 28px; cursor: crosshair; z-index: 3; }

    .splash-wrap { position: absolute; pointer-events: none; }

    .island { position: fixed; z-index: 4; pointer-events: none; }
    .island a { pointer-events: auto; }

    .sticky {
      background: #f5e97a;
      box-shadow: 2px 4px 14px #00000022;
      padding: 10px 14px 14px;
    }
    .index-card {
      background: #f0f6ff;
      box-shadow: 2px 3px 10px #00000015;
      padding: 10px 14px 14px;
      border-top: 3px solid #a8c0e0;
    }
    .torn {
      background: #fdfaf4;
      box-shadow: 2px 3px 10px #00000018;
      padding: 10px 14px 24px;
      clip-path: polygon(0 0, 100% 0, 100% 88%, 95% 92%, 90% 89%, 85% 93%, 78% 90%, 72% 95%, 65% 91%, 58% 96%, 50% 92%, 42% 96%, 35% 91%, 28% 95%, 20% 90%, 12% 94%, 5% 90%, 0 93%);
    }

    /* PHOTOS — polaroid-style prints */
    .photo-ph {
      position: fixed; z-index: 4;
      background: #fff;
      padding: 5px 5px 20px;
      box-shadow: 3px 5px 18px #00000038;
    }
    .photo-ph img {
      display: block;
      width: 76px; height: 86px;
      object-fit: cover;
    }
    #photo-1 { top: var(--photo1-top); left: var(--photo1-left); transform: rotate(7deg); }
    #photo-2 { top: var(--photo2-top); left: var(--photo2-left); transform: rotate(-5deg); z-index: 5; }
    #photo-3 { top: var(--photo3-top); left: var(--photo3-left); transform: rotate(2.5deg); }

    /* NAME */
    #name-block { top: var(--name-top); left: var(--name-left); transform: rotate(-2deg); }
    #hero-name { font-size: 6rem; font-weight: 800; line-height: 0.88; letter-spacing: -0.04em; color: #c8341a; }
    #hero-name .ln2 { display: block; color: #1c1a14; font-size: 4.6rem; }

    /* PROJECTS — row of pinned cards right of name/photos */
    #projects-block { top: var(--proj-top); left: var(--proj-left); display: flex; gap: 10px; transform: rotate(1deg); }
    .proj-card {
      width: 116px; padding: 8px 10px 12px;
      background: #faf7f0;
      box-shadow: 2px 3px 10px #00000018;
      pointer-events: none;
    }
    #projects-block .proj-card:nth-child(1) { transform: rotate(-3deg); }
    #projects-block .proj-card:nth-child(2) { transform: rotate(2.5deg); margin-top: 10px; }
    #projects-block .proj-card:nth-child(3) { transform: rotate(-1.5deg); margin-top: 3px; }
    .proj-title { font-size: 0.82rem; font-weight: 700; color: #c8341a; margin-bottom: 0.2rem; }
    .proj-sub   { font-size: 0.68rem; color: #7a6a50; font-style: italic; line-height: 1.4; }

    /* RESEARCH — torn paper, kept as decorative visual (skeleton content) */
    #research-block { top: var(--research-top); right: var(--research-right); width: 185px; transform: rotate(-3deg); }
    .res-label { font-size: 1.9rem; font-weight: 800; color: #2a5e8c; display: block; margin-bottom: 0.55rem; }
    .sk { height: 9px; background: #2a5e8c14; border-radius: 2px; margin-bottom: 8px; }

    /* WORK — hero, left→center */
    #work-block { top: var(--work-top); left: var(--work-left); width: var(--work-w); transform: rotate(-1.5deg); }
    .sec-label { font-size: 5rem; font-weight: 800; line-height: 1; display: block; margin-bottom: 0.8rem; letter-spacing: -0.03em; }
    .w-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 28px; }
    .w-item.span2 { grid-column: 1 / -1; }
    .w-title { font-size: 1.15rem; font-weight: 600; line-height: 1.2; }
    .w-title a { color: inherit; text-decoration: none; border-bottom: 1.5px solid #c8341a55; }
    .w-title a:hover { color: #c8341a; }
    .w-sub { font-size: 0.88rem; font-weight: 300; color: #7a6a50; font-style: italic; margin-top: 0.18rem; line-height: 1.55; }

    /* THINKING — index card, kept as decorative visual (skeleton content) */
    #thinking-block { top: var(--thinking-top); right: var(--thinking-right); width: 172px; transform: rotate(-4deg); }
    .sk-card { height: 8px; background: #1c1a1412; border-radius: 2px; margin-bottom: 9px; }

    /* INTRO — centered sticky */
    #intro-block { top: var(--intro-top); left: var(--intro-left); transform: translateX(-40%) rotate(1.5deg); width: 208px; }
    .intro-txt { font-size: 0.95rem; font-style: italic; font-weight: 300; color: #5a4830; line-height: 1.65; }

    /* FLOAT NOTE */
    #float-note { top: var(--float-top); left: var(--float-left); transform: rotate(4deg); }
    .float-txt { font-size: 0.82rem; font-style: italic; color: #7a6050; font-weight: 300; line-height: 1.5; }

    /* COMMUNITY — sticky, mid-right */
    #community-block { top: var(--community-top); right: var(--community-right); width: 188px; transform: rotate(2deg); position: fixed; z-index: 4; }
    #community-block .sticky { position: relative; }
    .pin {
      position: absolute; top: 9px; left: 50%; transform: translateX(-50%);
      width: 15px; height: 15px; border-radius: 50%;
      background: radial-gradient(circle at 40% 35%, #e85a3a, #8b2010);
      box-shadow: 0 2px 5px #00000045, 0 1px 2px #00000030;
      z-index: 5;
    }
    .pin::after {
      content: ''; position: absolute; top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 5px; height: 5px; border-radius: 50%;
      background: rgba(255,255,255,0.35);
    }
    .comm-label { font-size: 1.5rem; font-weight: 800; display: block; margin-bottom: 0.4rem; color: #2a2210; }
    .comm-txt { font-size: 0.9rem; font-weight: 400; line-height: 1.75; color: #3a2e10; }

    /* READING — bottom-right */
    #reading-block { bottom: var(--reading-bottom); right: var(--reading-right); transform: rotate(1deg); }
    .r-label { font-size: 1.3rem; font-weight: 700; color: #9a8a6c; display: block; margin-bottom: 0.5rem; }
    #book-list { position: relative; width: 390px; height: 178px; }
    .cover {
      position: absolute; width: 58px; height: 76px;
      border-radius: 1px 3px 3px 1px;
      box-shadow: 2px 3px 8px #00000030, inset -3px 0 6px #00000018;
      display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
      padding: 6px 5px 7px;
      transition: transform 0.15s, box-shadow 0.15s;
      cursor: pointer; pointer-events: auto; text-decoration: none;
    }
    .cover:hover { transform: scale(1.18) translateY(-5px) !important; box-shadow: 3px 6px 18px #00000045; z-index: 20 !important; }
    .cover::before { content: ''; position: absolute; top: 5px; left: 5px; right: 5px; height: 1px; background: rgba(255,255,255,0.2); }
    .cover::after  { content: ''; position: absolute; top: 0; right: 0; width: 4px; height: 100%; background: rgba(0,0,0,0.12); border-radius: 0 2px 2px 0; }
    .cover-title { font-size: 0.54rem; font-weight: 600; color: rgba(255,255,255,0.9); text-align: center; line-height: 1.3; text-shadow: 0 1px 2px rgba(0,0,0,0.4); }
    .t1 { background: linear-gradient(160deg, #3a5c7a, #4e7a9e); }
    .t2 { background: linear-gradient(160deg, #3d6645, #547a5c); }
    .t3 { background: linear-gradient(160deg, #7a3528, #9e4a3a); }
    #c-dream  { left: 2px;   top: 4px;  transform: rotate(-3deg);   z-index: 3; }
    #c-phil   { left: 66px;  top: 0px;  transform: rotate(1.5deg);  z-index: 2; }
    #c-mind   { left: 130px; top: 5px;  transform: rotate(-1deg);   z-index: 3; }
    #c-spell  { left: 194px; top: 2px;  transform: rotate(2.5deg);  z-index: 3; }
    #c-become { left: 258px; top: 7px;  transform: rotate(-2deg);   z-index: 2; }
    #c-love   { left: 322px; top: 3px;  transform: rotate(1deg);    z-index: 3; }
    #c-precip { left: 8px;   top: 92px; transform: rotate(-2deg);   z-index: 3; }
    #c-other  { left: 74px;  top: 87px; transform: rotate(2deg);    z-index: 2; }
    #c-live   { left: 138px; top: 94px; transform: rotate(-1.5deg); z-index: 3; }
    #c-align  { left: 202px; top: 88px; transform: rotate(3deg);    z-index: 2; }
    #cover-tip {
      position: fixed; background: #faf7f0; border-radius: 3px;
      padding: 5px 9px; font-size: 0.8rem; color: #4a3820;
      box-shadow: 1px 2px 6px #00000020; pointer-events: none; display: none; z-index: 30;
      max-width: 220px; line-height: 1.4;
    }

    /* LINKS — bottom-left */
    #links-block { bottom: var(--links-bottom); left: var(--links-left); transform: rotate(-2deg); }
    .cal-lnk { font-size: 1.6rem; font-weight: 700; color: #2a5e8c; display: block; text-decoration: none; margin-bottom: 0.3rem; }
    .cal-lnk:hover { text-decoration: underline; }
    .sm-links { display: flex; gap: 1rem; margin-top: 0.4rem; }
    .sm-lnk { font-size: 0.9rem; font-weight: 300; color: #5a4830; font-style: italic; text-decoration: none; }
    .sm-lnk:hover { color: #c8341a; }

    #hint {
      position: fixed; bottom: 8px; left: 50%; transform: translateX(-50%);
      font-size: 0.6rem; font-style: italic; color: #8a7248; opacity: 0.6;
      pointer-events: none; z-index: 10;
    }
  </style>
</head>
