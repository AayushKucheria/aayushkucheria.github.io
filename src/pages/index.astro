<script>
  import rough from 'roughjs';
  import { annotate } from 'rough-notation';

  const INSET = 0;
  const dotLayer = document.getElementById('dot-layer');
  const stored = JSON.parse(localStorage.getItem('wb-v1') || '[]');
  const MAX = 100;
  const NS = 'http://www.w3.org/2000/svg';

  function blob(cx, cy, r) {
    const n = 9;
    const pts = Array.from({length: n}, (_, i) => {
      const a = (i / n) * Math.PI * 2 - Math.PI / 2;
      const noise = 0.45 + Math.random() * 1.05;
      return [cx + Math.cos(a) * r * noise, cy + Math.sin(a) * r * noise];
    });
    let d = `M ${pts[0][0].toFixed(1)} ${pts[0][1].toFixed(1)}`;
    for (let i = 0; i < n; i++) {
      const p0 = pts[(i - 1 + n) % n], p1 = pts[i];
      const p2 = pts[(i + 1) % n],     p3 = pts[(i + 2) % n];
      const f = 1/6;
      const cp1x = p1[0] + (p2[0] - p0[0]) * f, cp1y = p1[1] + (p2[1] - p0[1]) * f;
      const cp2x = p2[0] - (p3[0] - p1[0]) * f, cp2y = p2[1] - (p3[1] - p1[1]) * f;
      d += ` C ${cp1x.toFixed(1)} ${cp1y.toFixed(1)}, ${cp2x.toFixed(1)} ${cp2y.toFixed(1)}, ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
    }
    return d + ' Z';
  }

  function renderSplash(x, y, isOld) {
    const wrap = document.createElement('div');
    wrap.className = 'splash-wrap';
    wrap.style.left = (x * window.innerWidth) + 'px';
    wrap.style.top  = (y * window.innerHeight) + 'px';

    const sz   = isOld ? (22 + Math.random() * 12) : (32 + Math.random() * 18);
    const rot  = Math.random() * 360;
    const col  = isOld ? '#4a3018' : '#8a4820';
    const base = isOld ? 0.12 : (0.68 + Math.random() * 0.18);

    const svg = document.createElementNS(NS, 'svg');
    svg.setAttribute('viewBox', '0 0 100 100');
    svg.style.cssText = [
      `display:block`,
      `width:${sz}px`, `height:${sz}px`,
      `overflow:visible`,
      `transform:translate(-50%,-50%) rotate(${rot}deg) scale(${isOld ? 1 : 0})`,
      isOld ? '' : `transition:transform 0.38s cubic-bezier(0.34,1.56,0.64,1)`,
    ].join(';');

    const bR = 17 + Math.random() * 9;
    const blobPath = document.createElementNS(NS, 'path');
    blobPath.setAttribute('d', blob(50, 50, bR));
    blobPath.setAttribute('fill', col);
    blobPath.setAttribute('opacity', base.toFixed(2));
    svg.appendChild(blobPath);

    const drops = 4 + Math.floor(Math.random() * 5);
    for (let i = 0; i < drops; i++) {
      const a    = Math.random() * Math.PI * 2;
      const dist = bR * (1.3 + Math.random() * 2.0);
      const dr   = bR * (0.05 + Math.random() * 0.18);
      const ecx  = (50 + Math.cos(a) * dist).toFixed(1);
      const ecy  = (50 + Math.sin(a) * dist).toFixed(1);
      const el = document.createElementNS(NS, 'ellipse');
      el.setAttribute('cx', ecx); el.setAttribute('cy', ecy);
      el.setAttribute('rx', dr.toFixed(1));
      el.setAttribute('ry', (dr * (0.45 + Math.random() * 0.9)).toFixed(1));
      el.setAttribute('fill', col);
      el.setAttribute('opacity', (base * (0.35 + Math.random() * 0.65)).toFixed(2));
      el.setAttribute('transform', `rotate(${(Math.random()*120-60).toFixed(0)} ${ecx} ${ecy})`);
      svg.appendChild(el);
    }

    wrap.appendChild(svg);
    document.body.appendChild(wrap);

    if (!isOld) {
      requestAnimationFrame(() => requestAnimationFrame(() => {
        svg.style.transform = `translate(-50%,-50%) rotate(${rot}deg) scale(1)`;
      }));
    }
  }

  stored.forEach(([x, y]) => renderSplash(x, y, true));

  dotLayer.addEventListener('click', e => {
    const x = e.clientX / window.innerWidth;
    const y = e.clientY / window.innerHeight;
    renderSplash(x, y, false);
    stored.push([x, y]);
    if (stored.length > MAX) stored.splice(0, stored.length - MAX);
    localStorage.setItem('wb-v1', JSON.stringify(stored));
  });

  function drawAll() {
    const canvas = document.getElementById('canvas');
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }

  function drawThreads() {
    const svg = document.getElementById('threads');
    svg.innerHTML = '';
    const THREAD = '#9a7a45';

    function edge(id, side, fx, fy) {
      const r = document.getElementById(id).getBoundingClientRect();
      if (side === 'r') return { x: r.right,              y: r.top + r.height * (fy ?? 0.5) };
      if (side === 'b') return { x: r.left + r.width * (fx ?? 0.5), y: r.bottom };
      if (side === 'l') return { x: r.left,               y: r.top + r.height * (fy ?? 0.5) };
      if (side === 't') return { x: r.left + r.width * (fx ?? 0.5), y: r.top };
    }

    function thread(x1, y1, x2, y2, cx, cy, op) {
      const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      p.setAttribute('d', `M ${x1},${y1} Q ${cx},${cy} ${x2},${y2}`);
      p.setAttribute('stroke', THREAD);
      p.setAttribute('stroke-width', '0.9');
      p.setAttribute('fill', 'none');
      p.setAttribute('opacity', op ?? '0.5');
      p.setAttribute('stroke-linecap', 'round');
      svg.appendChild(p);
    }

    // Connection threads
    let a, b;

    // name → work
    a = edge('name-block', 'b', 0.2);  b = edge('work-block', 't', 0.12);
    thread(a.x, a.y, b.x, b.y, a.x - 20, (a.y + b.y) / 2 + 15);

    // name → research
    a = edge('name-block', 'r', null, 0.4);  b = edge('research-block', 'l', null, 0.5);
    thread(a.x, a.y, b.x, b.y, a.x + 60, (a.y + b.y) / 2 - 20);

    // name → projects
    a = edge('name-block', 'r', null, 0.5);  b = edge('projects-block', 'l', null, 0.5);
    thread(a.x, a.y, b.x, b.y, (a.x + b.x) / 2, a.y - 18);

    // work → reading
    a = edge('work-block', 'b', 0.7);  b = edge('reading-block', 't', 0.2);
    thread(a.x, a.y, b.x, b.y, a.x + 80, (a.y + b.y) / 2 + 30);

    // Loose thread filaments — stray ends scattered on the cloth
    const filaments = [
      [120,180,38,18],[300,420,112,20],[580,80,160,16],[820,300,55,19],
      [1050,180,200,14],[1280,420,80,18],[200,640,140,17],[450,740,20,20],
      [700,670,165,15],[950,810,95,22],[1100,590,130,17],[1350,720,45,19],
      [80,470,75,16],[380,270,190,21],[640,490,30,18],[880,670,155,16],
      [1200,310,85,20],[1400,170,175,14],[260,550,60,22],[740,200,130,17],
    ];
    filaments.forEach(([x, y, ang, len]) => {
      const rad = ang * Math.PI / 180;
      const perp = (ang + 90) * Math.PI / 180;
      const bow = (Math.sin(x * 0.1 + y * 0.07) - 0.5) * 5;
      const mx = x + Math.cos(rad) * len * 0.5 + Math.cos(perp) * bow;
      const my = y + Math.sin(rad) * len * 0.5 + Math.sin(perp) * bow;
      thread(x, y, x + Math.cos(rad) * len, y + Math.sin(rad) * len, mx, my,
        String(0.15 + (Math.sin(x * 0.3 + y * 0.2) * 0.5 + 0.5) * 0.18));
    });
  }

  function runAnnotations() {
    setTimeout(() => annotate(document.getElementById('book-list'), {
      type: 'bracket', color: '#b09060',
      roughness: 3.8, strokeWidth: 2.5, padding: [18, 6, 12, 6], brackets: ['left'], animationDuration: 700,
    }).show(), 400);
  }

  const tip = document.getElementById('cover-tip');
  let coverZ = 10;
  document.querySelectorAll('.cover').forEach(c => {
    c.addEventListener('mouseenter', () => { tip.style.display = 'block'; tip.textContent = c.dataset.tip; c.style.zIndex = ++coverZ; });
    c.addEventListener('mousemove', e => { tip.style.left = (e.clientX + 12) + 'px'; tip.style.top = (e.clientY - 30) + 'px'; });
    c.addEventListener('mouseleave', () => { tip.style.display = 'none'; });
  });

  // ── Overlap detector — fires on load + resize, logs to console ──────────
  // Islands that may legitimately touch due to intentional placement.
  const KNOWN_OK = new Set([
    'hi-label|name-block',   // "hi, I'm" sits above the name by design
    'photo-1|photo-2', 'photo-1|photo-3', 'photo-1|photo-4',
    'photo-2|photo-3', 'photo-2|photo-4', 'photo-3|photo-4', // photos can fan
  ]);
  // Overlap on BOTH axes must exceed this many px to count as a violation.
  // Accounts for rotation: getBoundingClientRect() returns the AABB of a
  // rotated box, which is larger than the visual element, so small overlaps
  // in the AABB are expected and fine.
  const OVERLAP_THRESHOLD = 18;

  function checkOverlaps() {
    const els = [
      ...document.querySelectorAll('.island, .photo-ph'),
      document.getElementById('community-block'),
      document.getElementById('hi-label'),
    ].filter(Boolean);

    let violations = 0;
    for (let i = 0; i < els.length; i++) {
      for (let j = i + 1; j < els.length; j++) {
        const a = els[i], b = els[j];
        const idA = a.id || a.className.split(' ')[0];
        const idB = b.id || b.className.split(' ')[0];
        const key = [idA, idB].sort().join('|');
        if (KNOWN_OK.has(key)) continue;

        const ra = a.getBoundingClientRect(), rb = b.getBoundingClientRect();
        const overlapX = Math.min(ra.right, rb.right) - Math.max(ra.left, rb.left);
        const overlapY = Math.min(ra.bottom, rb.bottom) - Math.max(ra.top, rb.top);
        if (overlapX > OVERLAP_THRESHOLD && overlapY > OVERLAP_THRESHOLD) {
          console.error(
            `[layout] OVERLAP: "${idA}" and "${idB}" — ` +
            `${overlapX.toFixed(0)}px × ${overlapY.toFixed(0)}px`
          );
          violations++;
        }
      }
    }
    if (violations === 0) console.log('[layout] ✓ no overlaps detected');
  }

  const isDesktop = () => window.innerWidth >= 1200;

  window.addEventListener('load', () => {
    drawAll();
    if (isDesktop()) { drawThreads(); checkOverlaps(); }
    runAnnotations();
  });
  window.addEventListener('resize', () => {
    drawAll();
    if (isDesktop()) { drawThreads(); checkOverlaps(); }
  });
</script>

</body>
</html>
