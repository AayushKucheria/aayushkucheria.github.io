<script>
  import rough from 'roughjs';
  import { annotate } from 'rough-notation';

  const INSET = 28;
  const dotLayer = document.getElementById('dot-layer');
  const stored = JSON.parse(localStorage.getItem('wb-v1') || '[]');
  const MAX = 100;
  const NS = 'http://www.w3.org/2000/svg';

  function blob(cx, cy, r) {
    const n = 9;
    const pts = Array.from({length: n}, (_, i) => {
      const a = (i / n) * Math.PI * 2 - Math.PI / 2;
      const noise = 0.45 + Math.random() * 1.05;
      return [cx + Math.cos(a) * r * noise, cy + Math.sin(a) * r * noise];
    });
    let d = `M ${pts[0][0].toFixed(1)} ${pts[0][1].toFixed(1)}`;
    for (let i = 0; i < n; i++) {
      const p0 = pts[(i - 1 + n) % n], p1 = pts[i];
      const p2 = pts[(i + 1) % n],     p3 = pts[(i + 2) % n];
      const f = 1/6;
      const cp1x = p1[0] + (p2[0] - p0[0]) * f, cp1y = p1[1] + (p2[1] - p0[1]) * f;
      const cp2x = p2[0] - (p3[0] - p1[0]) * f, cp2y = p2[1] - (p3[1] - p1[1]) * f;
      d += ` C ${cp1x.toFixed(1)} ${cp1y.toFixed(1)}, ${cp2x.toFixed(1)} ${cp2y.toFixed(1)}, ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
    }
    return d + ' Z';
  }

  function renderSplash(x, y, isOld) {
    const wrap = document.createElement('div');
    wrap.className = 'splash-wrap';
    wrap.style.left = x * 100 + '%';
    wrap.style.top  = y * 100 + '%';

    const sz   = isOld ? (22 + Math.random() * 12) : (32 + Math.random() * 18);
    const rot  = Math.random() * 360;
    const col  = isOld ? '#5a3a18' : '#c8341a';
    const base = isOld ? 0.12 : (0.68 + Math.random() * 0.18);

    const svg = document.createElementNS(NS, 'svg');
    svg.setAttribute('viewBox', '0 0 100 100');
    svg.style.cssText = [
      `display:block`,
      `width:${sz}px`, `height:${sz}px`,
      `overflow:visible`,
      `transform:translate(-50%,-50%) rotate(${rot}deg) scale(${isOld ? 1 : 0})`,
      isOld ? '' : `transition:transform 0.38s cubic-bezier(0.34,1.56,0.64,1)`,
    ].join(';');

    const bR = 17 + Math.random() * 9;
    const blobPath = document.createElementNS(NS, 'path');
    blobPath.setAttribute('d', blob(50, 50, bR));
    blobPath.setAttribute('fill', col);
    blobPath.setAttribute('opacity', base.toFixed(2));
    svg.appendChild(blobPath);

    const drops = 4 + Math.floor(Math.random() * 5);
    for (let i = 0; i < drops; i++) {
      const a    = Math.random() * Math.PI * 2;
      const dist = bR * (1.3 + Math.random() * 2.0);
      const dr   = bR * (0.05 + Math.random() * 0.18);
      const ecx  = (50 + Math.cos(a) * dist).toFixed(1);
      const ecy  = (50 + Math.sin(a) * dist).toFixed(1);
      const el = document.createElementNS(NS, 'ellipse');
      el.setAttribute('cx', ecx); el.setAttribute('cy', ecy);
      el.setAttribute('rx', dr.toFixed(1));
      el.setAttribute('ry', (dr * (0.45 + Math.random() * 0.9)).toFixed(1));
      el.setAttribute('fill', col);
      el.setAttribute('opacity', (base * (0.35 + Math.random() * 0.65)).toFixed(2));
      el.setAttribute('transform', `rotate(${(Math.random()*120-60).toFixed(0)} ${ecx} ${ecy})`);
      svg.appendChild(el);
    }

    wrap.appendChild(svg);
    dotLayer.appendChild(wrap);

    if (!isOld) {
      requestAnimationFrame(() => requestAnimationFrame(() => {
        svg.style.transform = `translate(-50%,-50%) rotate(${rot}deg) scale(1)`;
      }));
    }
  }

  stored.forEach(([x, y]) => renderSplash(x, y, true));

  dotLayer.addEventListener('click', e => {
    const r = dotLayer.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width;
    const y = (e.clientY - r.top) / r.height;
    renderSplash(x, y, false);
    stored.push([x, y]);
    if (stored.length > MAX) stored.splice(0, stored.length - MAX);
    localStorage.setItem('wb-v1', JSON.stringify(stored));
  });

  function drawAll() {
    const canvas = document.getElementById('canvas');
    const W = window.innerWidth - INSET * 2;
    const H = window.innerHeight - INSET * 2;
    canvas.width = W;
    canvas.height = H;
    const rc = rough.canvas(canvas);

    function pt(id, fx, fy) {
      const r = document.getElementById(id).getBoundingClientRect();
      return {
        x: (r.left + r.width  * (fx ?? 0.5)) - INSET,
        y: (r.top  + r.height * (fy ?? 0.5)) - INSET,
      };
    }

    const conn = { roughness: 2.8, stroke: '#c8a87a77', strokeWidth: 1.7 };
    const atm  = { roughness: 3.8, stroke: '#c8a87a28', strokeWidth: 1.0 };
    const red  = { roughness: 3.2, stroke: '#c8341a33', strokeWidth: 1.2 };

    let a, b;

    // name → work
    a = pt('name-block', 0.2, 1);     b = pt('work-block', 0.12, 0);
    rc.curve([[a.x,a.y],[a.x-20,(a.y+b.y)/2+20],[b.x+40,(a.y+b.y)/2-10],[b.x,b.y]], conn);

    // name → research
    a = pt('name-block', 0.65, 0.4);  b = pt('research-block', 0.4, 1);
    rc.curve([[a.x,a.y],[a.x+60,(a.y+b.y)/2-30],[b.x-20,(a.y+b.y)/2+10],[b.x,b.y]], conn);

    // name → projects
    a = pt('name-block', 0.85, 0.5);  b = pt('projects-block', 0.1, 0.5);
    rc.curve([[a.x,a.y],[a.x+30,(a.y+b.y)/2],[b.x-20,(a.y+b.y)/2],[b.x,b.y]], conn);

    // work → reading
    a = pt('work-block', 0.7, 1);     b = pt('reading-block', 0.2, 0);
    rc.curve([[a.x,a.y],[a.x+80,(a.y+b.y)/2+40],[b.x-40,(a.y+b.y)/2-20],[b.x,b.y]], conn);

    // thinking-block → links
    a = pt('thinking-block', 0.3, 1); b = pt('links-block', 0.5, 0);
    rc.curve([[a.x,a.y],[a.x-60,(a.y+b.y)/2+20],[b.x+40,(a.y+b.y)/2-10],[b.x,b.y]], conn);

    // float-note → research (red)
    a = pt('float-note', 0.1, 0.3);   b = pt('research-block', 0.5, 0.8);
    rc.curve([[a.x,a.y],[a.x-40,(a.y+b.y)/2+10],[b.x+30,(a.y+b.y)/2-10],[b.x,b.y]], red);

    const rng = (a, b) => a + Math.random() * (b - a);
    for (let i = 0; i < 24; i++) {
      const x1 = rng(0, W), y1 = rng(0, H), len = rng(20, 160), ang = rng(0, Math.PI * 2);
      const x2 = x1 + Math.cos(ang) * len, y2 = y1 + Math.sin(ang) * len;
      rc.curve([
        [x1, y1],
        [x1 + (Math.random() - .5) * 70, y1 + (Math.random() - .5) * 70],
        [x2 + (Math.random() - .5) * 50, y2 + (Math.random() - .5) * 50],
        [x2, y2],
      ], atm);
    }
    for (let i = 0; i < 10; i++) {
      rc.circle(rng(0, W), rng(0, H), rng(2, 7), { roughness: 3.5, stroke: '#c8a87a33', strokeWidth: 1, fill: 'none' });
    }
  }

  function runAnnotations() {
    setTimeout(() => annotate(document.getElementById('work-lbl'), {
      type: 'highlight', color: '#f5c94255',
      roughness: 4, strokeWidth: 1, padding: 6, animationDuration: 700,
    }).show(), 200);

    setTimeout(() => annotate(document.getElementById('book-list'), {
      type: 'bracket', color: '#c8341a',
      roughness: 3.8, strokeWidth: 2.5, padding: [18, 6, 12, 6], brackets: ['left'], animationDuration: 700,
    }).show(), 800);
  }

  const tip = document.getElementById('cover-tip');
  document.querySelectorAll('.cover').forEach(c => {
    c.addEventListener('mouseenter', () => { tip.style.display = 'block'; tip.textContent = c.dataset.tip; });
    c.addEventListener('mousemove', e => { tip.style.left = (e.clientX + 12) + 'px'; tip.style.top = (e.clientY - 30) + 'px'; });
    c.addEventListener('mouseleave', () => { tip.style.display = 'none'; });
  });

  window.addEventListener('load', () => { drawAll(); runAnnotations(); });
  window.addEventListener('resize', drawAll);
</script>

</body>
</html>
