---
import { readFile } from 'node:fs/promises';
import SiteShell from '../components/SiteShell.astro';
import { renderMarkdown } from '../editor/content.mjs';
import sourceCopy from '../content/home.md?raw';
import Contact from '../components/Contact.astro';
import nameCopy from '../content/name.txt?raw';
import locationCopy from '../content/location.txt?raw';
const markdown = import.meta.env.DEV
  ? await readFile(new URL('../content/home.md', import.meta.url), 'utf8')
  : sourceCopy;
const introHtml = renderMarkdown(markdown);
const name = (import.meta.env.DEV
  ? await readFile(new URL('../content/name.txt', import.meta.url), 'utf8')
  : nameCopy).trim();
const location = (import.meta.env.DEV
  ? await readFile(new URL('../content/location.txt', import.meta.url), 'utf8')
  : locationCopy).trim();
---
<SiteShell name={name}>
    <header>
      <div class="photos" aria-label="Photos of Aayush and his work">
        <img src="/pics/eagx_image.jpg" alt="" style="object-position: center 15%" />
        <img src="/pics/wappu_image.JPG" alt="" style="object-position: center 20%" />
        <img src="/pics/amazon.jpg" alt="" style="object-position: center 10%" />
        <img src="/pics/stupid_image.jpg" alt="" style="object-position: center 15%" />
      </div>
      <div class="nameplate">
        <h1 class="site-name" data-content-section="name">{name}</h1>
        <span class="location" data-content-section="location">{location}</span>
      </div>
      <div class="intro" data-content-section="intro" set:html={introHtml} />
    </header>
    <Contact />

</SiteShell>
